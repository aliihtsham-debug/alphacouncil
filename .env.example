# ─── App ───────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Alpha Council

# ─── Database (Neon PostgreSQL) ────────────────
DATABASE_URL=postgresql://user:password@host:5432/alphacouncil

# ─── AI ─────────────────────────────────────────
# OpenRouter is the primary LLM provider for all agents
OPENROUTER_API_KEY=sk-or-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/owl-alpha

# OpenAI is optional fallback (leave empty to disable)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# ─── CoinMarketCap ──────────────────────────────
COINMARKETCAP_API_KEY=your-cmc-api-key
COINMARKETCAP_BASE_URL=https://pro-api.coinmarketcap.com/v1

# ─── Trust Wallet ───────────────────────────────
# (Client-side SDK, no server key needed)
NEXT_PUBLIC_TRUST_WALLET_APP_ID=your-trust-wallet-app-id

# ─── Monitoring ─────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn
NEXT_PUBLIC_POSTHOG_KEY=phc-your-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
